{
    "compilerOptions": {
        "outDir": "./dist",
        "rootDir": "./src",
        "lib": ["ESNext"],
        "target": "ESNext",
        "moduleResolution": "nodenext",
        "module": "nodenext",
        "strict": false,
        "sourceMap": true,
        "esModuleInterop": true, //permite usar import o require
        "declaration": true,
        "rewriteRelativeImportExtensions": true,
        "allowImportingTsExtensions": true
    },
    "include": ["src/**/*.ts"]
}